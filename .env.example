# .env.example - KHANS TRADING Ltd
# Variable names and purpose only. Never put a real value in this file (AGENTS.md Section 8).
# Source: INTEGRATIONS.md Section 12.

# Canonical URL
NEXT_PUBLIC_SITE_URL=

# Supabase (INTEGRATIONS.md Section 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # previously "anon key"
SUPABASE_SERVICE_ROLE_KEY=             # never exposed

# Cloudflare R2 (INTEGRATIONS.md Section 3.2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE=
R2_PUBLIC_BASE_URL=                    # https://media.[DOMAIN]

# Resend (INTEGRATIONS.md Section 5)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Cloudflare Turnstile (INTEGRATIONS.md Section 3.3)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Purchase tracker
TRACKER_SESSION_SECRET=                # signs tracker sessions

# Cron (only when cron is used)
CRON_SECRET=                           # protects scheduled endpoints

# Optional
SENTRY_DSN=

# Local dev only - agent tooling, not used by the application (INTEGRATIONS.md Section 6)
STITCH_API_KEY=
