{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "frontend",
  "share": "disabled",
  "instructions": ["DESIGN.md"],
  "mcp": {
    "servers": {
      "stitch": {
        "type": "remote",
        "url": "https://stitch.googleapis.com/mcp",
        "oauth": false,
        "headers": {
          "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
        }
      }
    }
  },
  "agents": {
    "frontend": {
      "description": "UI/UX and frontend engineer. Builds screens and components strictly from DESIGN.md.",
      "mode": "primary",
      "model": "opencode/mimo-v2.6-flash-free",
      "system": "{file:.opencode/prompts/frontend.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "src/app/*page.tsx", "effect": "allow" },
        { "action": "edit", "resource": "src/app/*layout.tsx", "effect": "allow" },
        { "action": "edit", "resource": "src/app/*loading.tsx", "effect": "allow" },
        { "action": "edit", "resource": "src/app/*error.tsx", "effect": "allow" },
        { "action": "edit", "resource": "src/app/*not-found.tsx", "effect": "allow" },
        { "action": "edit", "resource": "src/app/globals.css", "effect": "allow" },
        { "action": "edit", "resource": "src/components/*", "effect": "allow" },
        { "action": "edit", "resource": "src/features/*/components/*", "effect": "allow" },
        { "action": "edit", "resource": "src/hooks/*", "effect": "allow" },
        { "action": "edit", "resource": "src/styles/*", "effect": "allow" },
        { "action": "edit", "resource": "tailwind.config.*", "effect": "allow" },
        { "action": "edit", "resource": "public/*", "effect": "allow" },
        { "action": "edit", "resource": "src/config/*", "effect": "allow" },
        { "action": "edit", "resource": "tests/*", "effect": "allow" },
        { "action": "edit", "resource": "docs/TASKS.md", "effect": "allow" },
        { "action": "edit", "resource": "docs/DECISIONS.md", "effect": "allow" },
        { "action": "edit", "resource": "supabase/*", "effect": "deny" },
        { "action": "edit", "resource": "src/server/*", "effect": "deny" },
        { "action": "edit", "resource": "src/app/api/*", "effect": "deny" },
        { "action": "edit", "resource": "src/lib/supabase/*", "effect": "deny" },
        { "action": "edit", "resource": "src/lib/env.ts", "effect": "deny" },
        { "action": "edit", "resource": "src/types/database.ts", "effect": "deny" },
        { "action": "edit", "resource": "src/features/*/actions.ts", "effect": "deny" },
        { "action": "edit", "resource": "src/features/*/queries.ts", "effect": "deny" },
        { "action": "edit", "resource": "src/features/*/schemas.ts", "effect": "deny" },
        { "action": "edit", "resource": "src/features/*/types.ts", "effect": "deny" },
        { "action": "edit", "resource": "docs/DATABASE.md", "effect": "deny" },
        { "action": "edit", "resource": "docs/API.md", "effect": "deny" },
        { "action": "edit", "resource": "*.env*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "pnpm lint *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run lint *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm typecheck *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run typecheck *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm test *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run test *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm build *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run build *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm dev *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run dev *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec playwright *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm playwright *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run playwright *", "effect": "allow" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm add *", "effect": "ask" },
        { "action": "shell", "resource": "pnpm remove *", "effect": "ask" },
        { "action": "shell", "resource": "pnpm install *", "effect": "ask" },
        { "action": "shell", "resource": "pnpm i *", "effect": "ask" },
        { "action": "shell", "resource": "git add *", "effect": "ask" },
        { "action": "shell", "resource": "git commit *", "effect": "ask" },
        { "action": "shell", "resource": "git checkout *", "effect": "ask" },
        { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
        { "action": "shell", "resource": "git push *", "effect": "deny" },
        { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
        { "action": "shell", "resource": "git clean *", "effect": "deny" },
        { "action": "shell", "resource": "supabase *", "effect": "deny" },
        { "action": "shell", "resource": "npx supabase *", "effect": "deny" },
        { "action": "shell", "resource": "pnpm dlx supabase *", "effect": "deny" },
        { "action": "shell", "resource": "pnpm exec supabase *", "effect": "deny" },
        { "action": "shell", "resource": "pnpm supabase *", "effect": "deny" }
      ]
    },
    "backend": {
      "description": "Backend and database engineer. Owns schema, RLS, auth, storage, server actions, queries and API routes.",
      "mode": "primary",
      "model": "opencode/deepseek-v4.1-flash-free",
      "system": "{file:.opencode/prompts/backend.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "supabase/*", "effect": "allow" },
        { "action": "edit", "resource": "src/server/*", "effect": "allow" },
        { "action": "edit", "resource": "src/features/*/actions.ts", "effect": "allow" },
        { "action": "edit", "resource": "src/features/*/queries.ts", "effect": "allow" },
        { "action": "edit", "resource": "src/features/*/schemas.ts", "effect": "allow" },
        { "action": "edit", "resource": "src/features/*/types.ts", "effect": "allow" },
        { "action": "edit", "resource": "src/app/api/*", "effect": "allow" },
        { "action": "edit", "resource": "src/lib/supabase/*", "effect": "allow" },
        { "action": "edit", "resource": "src/lib/env.ts", "effect": "allow" },
        { "action": "edit", "resource": "src/types/database.ts", "effect": "allow" },
        { "action": "edit", "resource": "docs/DATABASE.md", "effect": "allow" },
        { "action": "edit", "resource": "docs/API.md", "effect": "allow" },
        { "action": "edit", "resource": "docs/TASKS.md", "effect": "allow" },
        { "action": "edit", "resource": "docs/DECISIONS.md", "effect": "allow" },
        { "action": "edit", "resource": "src/components/*", "effect": "deny" },
        { "action": "edit", "resource": "src/features/*/components/*", "effect": "deny" },
        { "action": "edit", "resource": "src/app/*page.tsx", "effect": "deny" },
        { "action": "edit", "resource": "src/app/*layout.tsx", "effect": "deny" },
        { "action": "edit", "resource": "src/app/*loading.tsx", "effect": "deny" },
        { "action": "edit", "resource": "src/app/*error.tsx", "effect": "deny" },
        { "action": "edit", "resource": "src/app/*not-found.tsx", "effect": "deny" },
        { "action": "edit", "resource": "src/app/globals.css", "effect": "deny" },
        { "action": "edit", "resource": "src/hooks/*", "effect": "deny" },
        { "action": "edit", "resource": "src/styles/*", "effect": "deny" },
        { "action": "edit", "resource": "tailwind.config.*", "effect": "deny" },
        { "action": "edit", "resource": "public/*", "effect": "deny" },
        { "action": "edit", "resource": "src/config/*", "effect": "deny" },
        { "action": "edit", "resource": "tests/*", "effect": "deny" },
        { "action": "edit", "resource": "*.env*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "pnpm lint *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run lint *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm typecheck *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run typecheck *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm test *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run test *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm build *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run build *", "effect": "allow" },
        { "action": "shell", "resource": "supabase status *", "effect": "allow" },
        { "action": "shell", "resource": "supabase start *", "effect": "allow" },
        { "action": "shell", "resource": "supabase stop *", "effect": "allow" },
        { "action": "shell", "resource": "supabase migration new *", "effect": "allow" },
        { "action": "shell", "resource": "supabase gen types *", "effect": "allow" },
        { "action": "shell", "resource": "supabase test db *", "effect": "allow" },
        { "action": "shell", "resource": "supabase db reset *", "effect": "allow" },
        { "action": "shell", "resource": "supabase gen types *--remote*", "effect": "ask" },
        { "action": "shell", "resource": "supabase test db *--remote*", "effect": "ask" },
        { "action": "shell", "resource": "supabase db reset *--remote*", "effect": "ask" },
        { "action": "shell", "resource": "supabase db push *", "effect": "ask" },
        { "action": "shell", "resource": "supabase link *", "effect": "ask" },
        { "action": "shell", "resource": "supabase migration repair *", "effect": "ask" },
        { "action": "shell", "resource": "supabase functions deploy *", "effect": "ask" },
        { "action": "shell", "resource": "supabase secrets *", "effect": "ask" },
        { "action": "shell", "resource": "pnpm add *", "effect": "ask" },
        { "action": "shell", "resource": "pnpm remove *", "effect": "ask" },
        { "action": "shell", "resource": "pnpm install *", "effect": "ask" },
        { "action": "shell", "resource": "pnpm i *", "effect": "ask" },
        { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
        { "action": "shell", "resource": "git push *", "effect": "deny" },
        { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
        { "action": "shell", "resource": "git clean *", "effect": "deny" },
        { "action": "stitch_*", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
